---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  description?: string;
}

const { eyebrow, title, subtitle, description } = Astro.props;
---

<section class="mb-10 rounded-3xl border border-[var(--color-border)] bg-[linear-gradient(145deg,color-mix(in_srgb,var(--color-surface)_92%,transparent)_0%,color-mix(in_srgb,var(--color-surface-elevated)_70%,transparent)_100%)] px-6 py-8 md:px-9 md:py-10">
  {eyebrow ? <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-text-muted)]">{eyebrow}</p> : null}

  <h1 class="mt-2 mb-0 max-w-[18ch] text-4xl font-semibold leading-[1.05] tracking-[-0.02em] text-[var(--color-text-primary)] md:text-6xl">
    {title}
  </h1>

  {subtitle ? <p class="mt-3 mb-0 text-lg font-medium text-[var(--color-text-primary)] md:text-xl">{subtitle}</p> : null}

  {description ? <p class="mt-4 mb-0 max-w-[72ch] text-[var(--color-text-secondary)]">{description}</p> : null}

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <slot name="actions" />
  </div>
</section>

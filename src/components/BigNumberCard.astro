---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<article class="rounded-2xl border border-[color-mix(in_srgb,var(--color-accent)_30%,var(--color-border))] bg-[linear-gradient(155deg,color-mix(in_srgb,var(--color-accent)_12%,var(--color-surface))_0%,var(--color-surface)_100%)] p-5 shadow-[0_12px_28px_color-mix(in_srgb,#020617_16%,transparent)]">
  <p class="m-0 text-4xl font-semibold leading-none tracking-[-0.02em] text-[var(--color-text-primary)] md:text-5xl">{value}</p>
  <p class="mt-3 mb-0 text-sm leading-relaxed text-[color-mix(in_srgb,var(--color-text-primary)_84%,var(--color-text-secondary))]">{label}</p>
</article>

---
interface Props {
  title: string;
  description: string;
  icon?: 'adobe' | 'architecture' | 'dxp' | 'cloud' | 'leadership' | 'ai';
}

const { title, description, icon = 'architecture' } = Astro.props;

const iconPath = {
  adobe: 'M6 18L12 4l6 14M8.5 13h7',
  architecture: 'M4 18h16M6 18V8l6-4 6 4v10M10 18v-5h4v5',
  dxp: 'M5 7h14v10H5zM9 10h6M9 13h4',
  cloud: 'M7 17h9a4 4 0 0 0 .2-8 5 5 0 0 0-9.7 1.6A3.5 3.5 0 0 0 7 17z',
  leadership: 'M12 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM5 20a7 7 0 0 1 14 0M4 12h3M17 12h3',
  ai: 'M12 3v3M12 18v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M3 12h3M18 12h3M4.9 19.1L7 17M17 7l2.1-2.1M9.5 9.5h5v5h-5z'
}[icon];
---

<article class="group relative overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-accent)_32%,var(--color-border))] bg-[linear-gradient(145deg,color-mix(in_srgb,var(--color-surface)_92%,transparent)_0%,color-mix(in_srgb,var(--color-surface-elevated)_72%,transparent)_100%)] p-5 shadow-[0_16px_32px_color-mix(in_srgb,#020617_16%,transparent)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_36px_color-mix(in_srgb,#020617_22%,transparent)]">
  <div class="absolute -right-8 -top-8 h-20 w-20 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] blur-2xl" aria-hidden="true"></div>

  <div class="relative mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[color-mix(in_srgb,var(--color-accent)_40%,var(--color-border))] bg-[color-mix(in_srgb,var(--color-accent)_10%,var(--color-surface))] text-[var(--color-text-primary)]">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d={iconPath} />
    </svg>
  </div>

  <h3 class="m-0 text-lg font-semibold leading-tight tracking-[-0.01em] text-[var(--color-text-primary)]">{title}</h3>
  <p class="mt-3 mb-0 text-sm leading-relaxed text-[color-mix(in_srgb,var(--color-text-primary)_82%,var(--color-text-secondary))]">{description}</p>
</article>

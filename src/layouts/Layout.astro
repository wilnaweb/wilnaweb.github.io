---
import '../styles/global.css';
import { replaceLocaleInPath } from '../lib/routing';
import { DEFAULT_LOCALE, HTML_LANG, LOCALES, OG_LOCALE, type Locale } from '../lib/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pathname: string;
}

const { title, description, locale, pathname } = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const normalizedPathname = pathname || Astro.url.pathname;

const pageTitle = title.includes('WIL.DEV') ? title : `${title} | WIL.DEV`;
const canonicalUrl = new URL(normalizedPathname, siteUrl).toString();
const alternateEntries = LOCALES.map((entryLocale) => ({
  hreflang: HTML_LANG[entryLocale],
  href: new URL(replaceLocaleInPath(normalizedPathname, entryLocale), siteUrl).toString()
}));
const xDefaultHref = new URL(replaceLocaleInPath(normalizedPathname, DEFAULT_LOCALE), siteUrl).toString();
const ogImage = new URL('/og-default.svg', siteUrl).toString();

const schemaPayload = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'WIL.DEV',
      url: new URL('/', siteUrl).toString(),
      inLanguage: HTML_LANG[locale]
    },
    {
      '@type': 'Person',
      name: 'Wilson Cavalcante',
      url: canonicalUrl,
      jobTitle: 'Software Architect',
      inLanguage: HTML_LANG[locale]
    }
  ]
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <!-- Google Tag Manager -->
    <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NKJXKFL2');`}></script>
    <!-- End Google Tag Manager -->
    <link rel="preload" as="image" href="/wordmark-transparent-white.png" media="(prefers-color-scheme: dark)">
    <link rel="preload" as="image" href="/wordmark-transparent.png" media="(prefers-color-scheme: light)">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateEntries.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="WIL.DEV" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schemaPayload)}></script>
  </head>
  <body class="bg-[var(--color-background)] text-[var(--color-text-primary)] antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NKJXKFL2" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="site-background" aria-hidden="true"></div>
    <main class="relative mx-auto min-h-screen w-full px-5 py-8 md:px-8 md:py-12">
      <slot />
    </main>
    <script type="module" src="/js/theme-logo.js"></script>
    <script>
      if (window && window.themeLogoInit) {
        window.themeLogoInit([
          { id: 'site-wordmark', light: '/wordmark-transparent.png', dark: '/wordmark-transparent-white.png' },
          { id: 'site-wordmark-footer', light: '/wordmark-transparent.png', dark: '/wordmark-transparent-white.png' }
        ]);
      }
    </script>
  </body>
</html>
